---
// Curva acumulada (Pareto). series = [{ nombre, curva: [{pct_elementos, pct_facturacion}], marca?: {x, texto}, gris? }]
// Dibuja también la diagonal del reparto igual y la línea del 80 %.
const { series = [], height = 330, label = 'Curva acumulada de facturación' } = Astro.props;
const W = 760, H = height, padL = 46, padR = 18, padT = 14, padB = 40;
const X = (v) => padL + (v / 100) * (W - padL - padR);
const Y = (v) => padT + (1 - v / 100) * (H - padT - padB);
const trazo = (c) => [{ pct_elementos: 0, pct_facturacion: 0 }, ...c].map((p, i) => `${i ? 'L' : 'M'}${X(p.pct_elementos).toFixed(1)},${Y(p.pct_facturacion).toFixed(1)}`).join(' ');
const color = (s) => (s.gris ? 'var(--color-tinta-soft)' : 'var(--color-acento)');
const ejes = [0, 20, 40, 60, 80, 100];
const ly = H - padB - 62;
---
<svg viewBox={`0 0 ${W} ${H}`} class="w-full h-auto" role="img" aria-label={label}>
  {ejes.map((v) => (
    <g>
      <text x={padL - 8} y={Y(v) + 4} text-anchor="end" font-size="11" fill="var(--color-suave)">{v} %</text>
      <text x={X(v)} y={H - padB + 16} text-anchor="middle" font-size="11" fill="var(--color-suave)">{v} %</text>
    </g>
  ))}
  <text x={X(50)} y={H - 6} text-anchor="middle" font-size="11" fill="var(--color-suave)">Elementos, ordenados de mayor a menor facturación</text>
  <line x1={padL} y1={padT} x2={padL} y2={H - padB} stroke="var(--color-linea)" stroke-width="1" />
  <line x1={padL} y1={H - padB} x2={W - padR} y2={H - padB} stroke="var(--color-linea)" stroke-width="1" />
  <line x1={X(0)} y1={Y(0)} x2={X(100)} y2={Y(100)} stroke="var(--color-suave)" stroke-width="1" stroke-dasharray="2 4" />
  <line x1={padL} y1={Y(80)} x2={W - padR} y2={Y(80)} stroke="#b45309" stroke-width="1.2" stroke-dasharray="5 4" />
  <text x={padL + 8} y={Y(80) - 6} font-size="11" font-weight="600" fill="#92400e">80 % de la facturación</text>
  {series.map((s) => (
    <path d={trazo(s.curva)} fill="none" stroke={color(s)} stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round" />
  ))}
  {series.filter((s) => s.marca).map((s) => {
    const p = s.curva.find((q) => q.pct_elementos >= s.marca.x) || s.curva[s.curva.length - 1];
    return (
      <g>
        <circle cx={X(p.pct_elementos)} cy={Y(p.pct_facturacion)} r="5" fill={color(s)} stroke="#fff" stroke-width="1.5" />
        <text x={X(p.pct_elementos) - 9} y={Y(p.pct_facturacion) - 9} text-anchor="end" font-size="11.5" font-weight="700" fill={color(s)} paint-order="stroke" stroke="#fff" stroke-width="3">{s.marca.texto}</text>
      </g>
    );
  })}
  <g font-size="11" fill="var(--color-tinta-soft)">
    {series.map((s, i) => (
      <g>
        <line x1={W - padR - 190} y1={ly + i * 18} x2={W - padR - 166} y2={ly + i * 18} stroke={color(s)} stroke-width="2.4" />
        <text x={W - padR - 160} y={ly + i * 18 + 4}>{s.nombre}</text>
      </g>
    ))}
    <line x1={W - padR - 190} y1={ly + series.length * 18} x2={W - padR - 166} y2={ly + series.length * 18} stroke="var(--color-suave)" stroke-width="1" stroke-dasharray="2 4" />
    <text x={W - padR - 160} y={ly + series.length * 18 + 4}>Si todos facturaran igual</text>
  </g>
</svg>
