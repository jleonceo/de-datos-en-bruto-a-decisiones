---
/* Molde de una subpágina de concepto. Seis pasos en orden fijo:
   el problema con el caso delante, por qué engaña, el principio en una frase, la solución,
   qué pasa con estos datos y para qué sirve. El detalle técnico va plegado al final.

   Los seis slots van escritos uno a uno porque Astro exige que `slot name` sea una cadena
   estática: generarlos con un map falla al compilar.

   Props: ficha (código del plan, p. ej. F9), titulo, madre {slug, t}, pregunta. */
const { ficha = '', titulo = '', madre = null, pregunta = '' } = Astro.props;
---
<div class="max-w-3xl">
  {madre && (
    <p class="text-[.78rem] text-suave">
      <a href={madre.slug} class="text-acento no-underline hover:underline">&larr; {madre.t}</a>
      {ficha && <span class="ml-2 rounded bg-crema px-1.5 py-[2px] font-mono text-[.7rem] text-suave">{ficha}</span>}
    </p>
  )}

  <h1 class="mt-3 font-display text-[1.9rem] font-bold leading-tight">{titulo}</h1>

  {pregunta && (
    <div class="mt-4 rounded-lg border border-linea bg-crema p-4">
      <div class="text-[.75rem] font-semibold uppercase tracking-wide text-suave">La pregunta de esta página</div>
      <p class="mt-1 text-[1.02rem] text-tinta">{pregunta}</p>
    </div>
  )}

  <section class="mt-8">
    <h2 class="flex items-baseline gap-2 font-display text-[1.15rem] font-bold">
      <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-acento-claro text-[.78rem] font-bold text-acento-deep">1</span>
      El problema
    </h2>
    <div class="mt-2 space-y-3 text-tinta-soft"><slot name="problema" /></div>
  </section>

  <section class="mt-8">
    <h2 class="flex items-baseline gap-2 font-display text-[1.15rem] font-bold">
      <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-acento-claro text-[.78rem] font-bold text-acento-deep">2</span>
      Por qué engaña
    </h2>
    <div class="mt-2 space-y-3 text-tinta-soft"><slot name="engana" /></div>
  </section>

  <section class="mt-8">
    <h2 class="flex items-baseline gap-2 font-display text-[1.15rem] font-bold">
      <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-acento-claro text-[.78rem] font-bold text-acento-deep">3</span>
      El principio
    </h2>
    <div class="mt-2 space-y-3 text-tinta-soft"><slot name="principio" /></div>
  </section>

  <section class="mt-8">
    <h2 class="flex items-baseline gap-2 font-display text-[1.15rem] font-bold">
      <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-acento-claro text-[.78rem] font-bold text-acento-deep">4</span>
      La solución
    </h2>
    <div class="mt-2 space-y-3 text-tinta-soft"><slot name="solucion" /></div>
  </section>

  <section class="mt-8">
    <h2 class="flex items-baseline gap-2 font-display text-[1.15rem] font-bold">
      <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-acento-claro text-[.78rem] font-bold text-acento-deep">5</span>
      Qué pasa con estos datos
    </h2>
    <div class="mt-2 space-y-3 text-tinta-soft"><slot name="datos" /></div>
  </section>

  <section class="mt-8">
    <h2 class="flex items-baseline gap-2 font-display text-[1.15rem] font-bold">
      <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-acento-claro text-[.78rem] font-bold text-acento-deep">6</span>
      Para qué sirve
    </h2>
    <div class="mt-2 space-y-3 text-tinta-soft"><slot name="sirve" /></div>
  </section>

  <details class="mt-10 rounded-lg border border-linea bg-crema/60 p-4">
    <summary class="cursor-pointer text-[.88rem] font-semibold text-tinta">El detalle técnico</summary>
    <div class="mt-3 text-[.86rem] text-tinta-soft"><slot name="tecnico" /></div>
  </details>
</div>
