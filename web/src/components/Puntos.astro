---
// Un punto por categoría, con líneas de referencia. El eje no empieza en cero: por eso son
// puntos y no columnas, que con el eje cortado exagerarían las diferencias.
// items = [{ label, value, destacar? }] · lineas = [{ valor, etiqueta, lado?: 'izq'|'der', debajo?, color? }]
const { items = [], lineas = [], height = 280, unit = '', label = 'Gráfico de puntos' } = Astro.props;
const W = 760, H = height, padL = 70, padR = 16, padT = 22, padB = 30;
const vals = [...items.map((i) => i.value), ...lineas.map((l) => l.valor)];
const lo = Math.min(...vals), hi = Math.max(...vals);
const margen = (hi - lo || 1) * 0.12;
const ymin = lo - margen, ymax = hi + margen;
const Y = (v) => padT + (1 - (v - ymin) / (ymax - ymin)) * (H - padT - padB);
const n = items.length || 1;
const paso = (W - padL - padR) / n;
const fmt = (v) => new Intl.NumberFormat('es-ES', { useGrouping: true, maximumFractionDigits: 0 }).format(v);
---
<svg viewBox={`0 0 ${W} ${H}`} class="w-full h-auto" role="img" aria-label={label}>
  <line x1={padL} y1={padT} x2={padL} y2={H - padB} stroke="var(--color-linea)" stroke-width="1" />
  <line x1={padL} y1={H - padB} x2={W - padR} y2={H - padB} stroke="var(--color-linea)" stroke-width="1" />
  <text x={padL - 8} y={Y(hi) + 4} text-anchor="end" font-size="11" fill="var(--color-suave)">{fmt(hi)}</text>
  <text x={padL - 8} y={Y(lo) + 4} text-anchor="end" font-size="11" fill="var(--color-suave)">{fmt(lo)}</text>
  {lineas.map((l) => (
    <g>
      <line x1={padL} y1={Y(l.valor)} x2={W - padR} y2={Y(l.valor)} stroke={l.color || 'var(--color-suave)'} stroke-width="1.3" stroke-dasharray="5 4" />
      <text x={l.lado === 'izq' ? padL + 8 : W - padR - 4} y={Y(l.valor) + (l.debajo ? 14 : -6)} text-anchor={l.lado === 'izq' ? 'start' : 'end'}
        font-size="11" font-weight="600" fill={l.color || 'var(--color-tinta-soft)'}>{l.etiqueta}: {fmt(l.valor)}{unit}</text>
    </g>
  ))}
  {items.map((it, i) => {
    const cx = padL + paso * (i + 0.5);
    return (
      <g>
        <circle cx={cx.toFixed(1)} cy={Y(it.value).toFixed(1)} r={it.destacar ? 6.5 : 5} fill="var(--color-acento)" opacity={it.destacar ? 1 : 0.6} />
        {it.destacar && <text x={cx.toFixed(1)} y={(Y(it.value) - 11).toFixed(1)} text-anchor="middle" font-size="11.5" font-weight="700" fill="var(--color-acento-deep)">{fmt(it.value)}{unit}</text>}
        <text x={cx.toFixed(1)} y={H - padB + 16} text-anchor="middle" font-size="10.5" fill="var(--color-suave)">{it.label}</text>
      </g>
    );
  })}
</svg>
